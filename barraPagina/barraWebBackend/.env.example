# Servidor
PORT=4000
PUBLIC_URL=http://localhost:5173

# MySQL
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=barra_web

# Mercado Pago (sandbox: usar credenciales de prueba del dashboard de MP)
MP_ACCESS_TOKEN=
MP_WEBHOOK_SECRET=

# SMTP para el envío de mails (si se deja vacío, los mails se loguean por consola)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=no-reply@barra.example.com

# Link de descarga del instalador de barraAplicacion
DOWNLOAD_URL=https://barra.example.com/descargar

# Admin
ADMIN_USER=admin
ADMIN_PASSWORD=cambiar-esta-password
